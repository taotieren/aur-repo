# Maintainer: taotieren <admin@taotieren.com>

pkgname=rkdeveloptool-gui
pkgver=5.7.1
pkgrel=5
pkgdesc="RKDevelopTool GUI is a graphical front-end for Rockchip's official rkdeveloptool"
arch=(any)
url="https://github.com/gahingwoo/RKDevelopTool-GUI"
license=('GPL-3.0-only')
provides=(${pkgname})
conflicts=(${pkgname})
replaces=()
depends=(
    hicolor-icon-theme
    pyside6
    python
    python-certifi
    # AUR
    rkdeveloptool
)
makedepends=(
    'git'
    'python-build'
    'python-installer'
    'python-setuptools'
    'python-wheel'
)
optdepends=(
)
backup=()
install=
source=(
    "${pkgname}::git+${url}.git#tag=${pkgver}")
sha256sums=('b04cffcd69b513b04c7cbf9e02aa6ce004feb6cb65f83c87852dc85c587543da')

prepare() {
    git -C "${srcdir}/${pkgname}" clean -dfx
}

build() {
    cd "${srcdir}/${pkgname}/"
    python -m build --wheel --no-isolation
}

check() {
    cd "${srcdir}/${pkgname}/"

    local _wheel _dest _purelib
    _wheel=$(printf '%s\n' dist/*.whl | head -1)
    [[ -f "$_wheel" ]] || { echo "==> Wheel not found" >&2; return 1; }

    _dest="$srcdir/_check-root"
    rm -rf "$_dest"
    python -m installer --destdir="$_dest" "$_wheel"
    _purelib=$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
    export PYTHONPATH="$_dest/${_purelib#/}${PYTHONPATH:+:$PYTHONPATH}"

    export QT_QPA_PLATFORM=offscreen QT_SCALE_FACTOR=1 QT_FONT_DPI=96
    export LANG=C.UTF-8 LC_ALL=C.UTF-8

    for t in loader_merge rkfw_layouts; do
    echo "==> $t"
    python "tests/$t.py" || return 1
    done

    echo "==> smoke"
    local _log="$srcdir/smoke.log" _unexpected _fatal
    if python tests/smoke.py >"$_log" 2>&1; then
    cat "$_log"
    return 0
    fi
    cat "$_log"

    if ! grep -q 'SMOKE TEST FAILED' "$_log"; then
    echo "==> smoke exited abnormally (summary not printed); treat as a true failure" >&2
    return 1
    fi

    _unexpected=$(sed -n 's/^ \* //p' "$_log" \
    | grep -vF -e 'wider than the panel at' \
                -e "QLineEdit isn't under its own centre" \
                -e 'command line after a drop' || true)
    _fatal=$(grep -E '^Traceback|^Aborted|Segmentation fault|ModuleNotFoundError' "$_log" || true)

    if [[ -n "$_fatal" || -n "$_unexpected" ]]; then
    echo "==> If a non-environmental failure occurs in smoke, treat it as a true failure." >&2
    printf '%s\n' "$_fatal" "$_unexpected" | sed '/^$/d' >&2
    return 1
    fi
    echo "==> smoke: Only “clean chroot” has known layout/composite event discrepancies; downgraded to a warning"
}

package() {
    cd "${srcdir}/${pkgname}/"
    python -m installer --destdir="${pkgdir}" dist/*.whl
    install -vDm644 "LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
    install -vDm644 *.md -t "${pkgdir}/usr/share/doc/${pkgname}/"
    install -vDm644 packaging/*.desktop -t "${pkgdir}/usr/share/applications/"
    install -vDm644 packaging/*.appdata.xml -t "${pkgdir}/usr/share/metainfo/"
    install -vDm644 packaging/icon/*.svg -t "${pkgdir}//usr/share/icons/hicolor/scalable/apps/"
    install -vDm644 packaging/*.rules -t "${pkgdir}/usr/lib/udev/rules.d/"
}
