# Maintainer: taotieren <admin@taotieren.com>

pkgbase=rkbin-git
pkgname=rkbin-git
pkgver=r2390.3e288fe
pkgrel=2
epoch=
pkgdesc="Rockchip Firmware and Tool Binarys"
arch=('x86_64')
url="https://github.com/rockchip-linux/rkbin"
license=('Commercial')
groups=()
depends=(
    'sh'
    'libstdc++'
    'libusb'
    'python'
)
makedepends=('git')
checkdepends=()
optdepends=()
provides=(rkbin)
conflicts=(rkbin)
replaces=(rkbin)
backup=()
options=(!debug !lto !strip)
install=
changelog=
source=("${pkgname%-git}::git+${url}.git")
noextract=()
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname%-git}"
    (
        set -o pipefail
        git describe --long --tag --abbrev=7 2>/dev/null | sed 's/^v//g;s/\([^-]*-g\)/r\1/;s/-/./g' ||
            printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    )
}

prepare() {
    git -C "${srcdir}/${pkgname%-git}" clean -dfx
}

package() {
    install -dm0755 "${pkgdir}/opt/rockchip/"

    cp -r ${srcdir}/${pkgname%-git} "${pkgdir}/opt/rockchip/"
    rm -rf ${pkgdir}/opt/rockchip/${pkgname%-git}/.*

    install -Dm0644 /dev/stdin "${pkgdir}/etc/profile.d/${pkgname%-git}.csh" <<EOF
setenv PATH "${PATH}:/opt/rockchip/${pkgname%-git}/tools/"
EOF
    install -Dm0644 /dev/stdin "${pkgdir}/etc/profile.d/${pkgname%-git}.sh" <<EOF
#!/bin/sh
# rkbin

[ -d /opt/rockchip/rkbin/tools/ ] && append_path '/opt/rockchip/rkbin/tools/'

export PATH
EOF
}
