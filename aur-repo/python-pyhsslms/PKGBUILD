# Maintainer: taotieren <admin@taotieren.com>

pkgname=python-pyhsslms
_name=${pkgname#python-}
pkgver=2.0.0
pkgrel=1
pkgdesc="HSS/LMS Digital Signature library for Python"
provides=(${pkgname})
conflicts=(${pkgname})
arch=('any')
url="https://github.com/russhousley/pyhsslms"
_pydeps=(
    pycryptodomex
)
depends=(
    'python'
    "${_pydeps[@]/#/python-}"
)
makedepends=(
    git
    'python-build'
    'python-installer'
    'python-setuptools'
    'python-wheel'
)
optdepends=()
license=('MIT')
source=("${_name}::git+${url}.git#tag=$pkgver")
sha256sums=('08e85ac688718ac316cbcecaa95c610d8094a299536e14379b78eb091adf446a')

prepare() {
    git -C "${srcdir}/${_name}" clean -dfx
}

build() {
    cd "${srcdir}/${_name}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${srcdir}/${_name}"
    python -m installer --destdir="${pkgdir}" dist/*.whl
    install -Dm0644 LICENSE* "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
