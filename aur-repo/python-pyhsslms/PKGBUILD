# Maintainer: taotieren <admin@taotieren.com>

pkgname=python-pyhsslms
_name=${pkgname#python-}
pkgver=1.1.1
pkgrel=1
pkgdesc="HSS/LMS Digital Signature library for Python"
provides=(${pkgname})
conflicts=(${pkgname})
arch=('any')
url="https://github.com/russhousley/pyhsslms"
_pydeps=(
    pycryptodomex
)
depends=(
    'python'
    "${_pydeps[@]/#/python-}"
)
makedepends=(
    git
    'python-build'
    'python-installer'
    'python-setuptools'
    'python-wheel'
)
optdepends=()
license=('MIT')
source=("${_name}::git+${url}.git#tag=$pkgver")
sha256sums=('e819eff6669ae0af6f8a8809519c4f6fa6385b9845cea5b7eb0a2399c81f44d6')

prepare() {
    git -C "${srcdir}/${_name}" clean -dfx
}

build() {
    cd "${srcdir}/${_name}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${srcdir}/${_name}"
    python -m installer --destdir="${pkgdir}" dist/*.whl
    install -Dm0644 LICENSE* "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
