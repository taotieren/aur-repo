_color_msg() {
    local color="$1" msg="$2"
    echo -e "\033[${color}m${msg}\033[0m"
}

post_install() {
    _color_msg "1;36" "Candle (秉烛) installed successfully!"
    echo
    _color_msg "1;33" "==> Add your user to the input group:"
    _color_msg "1;32" "    sudo usermod -aG input \$USER"
    _color_msg "1;32" "    newgrp input"
    echo
}

post_upgrade() {
    systemctl daemon-reload
    systemctl restart org.yxzl.candle.service
    _color_msg "1;32" "==> org.yxzl.candle.service restarted."
}

pre_remove() {
    _color_msg "1;33" "==> Stopping and disabling org.yxzl.candle.service..."
    systemctl stop org.yxzl.candle.service
    systemctl disable org.yxzl.candle.service
}

post_remove() {
    systemctl daemon-reload
    _color_msg "1;31" "==> Candle (秉烛) removed."
}