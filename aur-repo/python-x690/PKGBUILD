# Maintainer: taotieren <admin@taotieren.com>

pkgname=python-x690
_name=${pkgname#python-}
pkgver=1.0.0.post1
pkgrel=6
epoch=
pkgdesc="Pure Python X.690 implementation"
arch=('any')
url="https://github.com/exhuma/x690"
license=(MIT)
groups=()
provides=(${pkgname})
conflicts=(${pkgname})
_pydeps=(
    asn1crypto
    importlib-metadata
    pytest
    # AUR
    asn1tools
    pycrate
    t61codec
)
depends=(
    python
    "${_pydeps[@]/#/python-}"
)
makedepends=(
    git
    python-hatchling
    python-build
    python-installer
    python-wheel
    python-setuptools
)
optdepends=()
options=('!strip' '!debug')
source=("${_name}::git+${url}.git#tag=v${pkgver}")
noextract=()
sha256sums=('3a2a8a4e479079188aa6e847814981286b8f1c19569898fa3fe573ee0ce05349')

prepare() {
    git -C "${srcdir}/${_name}" clean -dfx
}

build() {
    cd "${srcdir}/${_name}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${srcdir}/${_name}"
    python -m installer --destdir="${pkgdir}" dist/*.whl
    install -Dm0644 LICENSE.txt -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
