# Maintainer: LY <ly-niko@qq.com>
# Co-Maintainer: taotieren <admin@taotieren.com>

pkgname=python-py-key-value-aio
_name=${pkgname#python-}
_name=${_name//-/_}
pkgver=0.4.5
pkgrel=3
pkgdesc="Async key-value store with pluggable backends"
arch=('any')
url="https://github.com/chrisguidry/py-key-value-aio"
license=('Apache-2.0')
_py_deps=(
  # aerospike
  anyio
  aioboto3
  aiobotocore
  aiofile
  aiomcache
  asyncpg
  cachetools
  cryptography
  beartype
  botocore
  diskcache
  duckdb
  elastic-transport
  elasticsearch
  google-auth
  hvac
  keyring
  opensearch
  pathvalidate
  pydantic
  pydantic-core
  pymongo
  redis
  typing_extensions
)
depends=(
  python
  "${_py_deps[@]/#/python-}"
)
optdepends=()
makedepends=(
  'python-build' 
  'python-installer' 
  'python-wheel' 
  'python-uv-build'
)
source=("${_name}-${pkgver}.tar.gz::https://files.pythonhosted.org/packages/source/${_name::1}/$_name/$_name-$pkgver.tar.gz")
sha256sums=('c6563a2c6abe5da5e20f4f9e875c2a9b425a2244a54fadbf46cf140a9eea45d7')

prepare() {
  cd "${_name}-${pkgver}"
  sed -i '/uv_build/s/,<[0-9.]\+//' pyproject.toml
}

build() {
  cd "${_name}-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${_name}-${pkgver}"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
