# Maintainer: taotieren <admin@taotieren.com>

_pkgname=affine
pkgname=python-${_pkgname}
pkgver=3.0.0
pkgrel=1
pkgdesc="Python package for matrices describing affine transformation of the plane"
url='https://github.com/rasterio/affine'
makedepends=('git'
             'python-build'
             'python-installer'
             'python-wheel'
             'python-flit-core'
            )
depends=('python'
    'python-attrs'
)
optdepends=()
license=('BSD-3-Clause')
arch=('any')
source=("${_pkgname}::git+${url}.git#tag=${pkgver}")
sha256sums=('cb414404a4afa982cdf1dcdfb196c63b60b7cca9507dd45e1dd13fcce28ee558')

prepare() {
    git -C "${srcdir}/${_pkgname}" clean -dfx
    cd "${srcdir}/${_pkgname}"
    sed -i 's|<4|<5|' pyproject.toml
}

build() {
    cd "$srcdir/${_pkgname}"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/${_pkgname}"

    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE.txt
}
